#!/usr/bin/env bash
# Load pinned tmux persistence plugins and start one guarded restore attempt.
set -u

marker="${XDG_CONFIG_HOME:-$HOME/.config}/envy/tmux-persistence.enabled"
[[ -f "$marker" ]] || exit 0

plugin_root="$HOME/.local/share/envy/tmux"
resurrect="$plugin_root/tmux-resurrect"
continuum="$plugin_root/tmux-continuum"
snapshot="$HOME/.local/bin/nv-tmux-snapshot"
save_tool="$HOME/.local/bin/nv-tmux-save"
restore_tool="$HOME/.local/bin/nv-tmux-restore"

[[ -x "$resurrect/resurrect.tmux" && -x "$continuum/continuum.tmux" ]] || exit 0
[[ -x "$snapshot" && -x "$save_tool" && -x "$restore_tool" ]] || exit 0

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
host_key=$(hostname -s 2>/dev/null || hostname)
resurrect_dir="$state_home/tmux/resurrect/$host_key"
umask 077
mkdir -p "$resurrect_dir"
chmod 700 "$resurrect_dir"

printf -v snapshot_command '%q' "$snapshot"
printf -v save_command '%q quiet' "$save_tool"

tmux set-option -gq @nv_tmux_persistence 1
tmux set-option -gq @resurrect-dir "$resurrect_dir"
tmux set-option -gq @resurrect-processes 'nv-agent-resume'
tmux set-option -gq @resurrect-hook-post-save-layout "$snapshot_command"
tmux set-option -gq @resurrect-save-script-path "$resurrect/scripts/save.sh"
tmux set-option -gq @resurrect-restore-script-path "$resurrect/scripts/restore.sh"

"$resurrect/resurrect.tmux"

tmux set-option -gq @nv_resurrect-save-script "$resurrect/scripts/save.sh"
tmux set-option -gq @resurrect-save-script-path "$save_tool"
tmux bind-key C-s run-shell "$save_tool"

tmux set-option -gq @continuum-save-interval 5
tmux set-option -gq @continuum-restore off
"$continuum/continuum.tmux"

tmux set-hook -g 'client-detached[90]' "run-shell -b '$save_command'"
tmux set-hook -g 'session-closed[90]' "run-shell -b '$save_command'"

"$restore_tool" --startup >/dev/null 2>&1 &
