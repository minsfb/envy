#!/usr/bin/env bash
# Convert an Alacritty bell into one local macOS Notification Center alert.
set -u

[[ "$(uname -s 2>/dev/null)" == Darwin ]] || exit 0
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
[[ -r "$CONFIG_HOME/mins-env/agent-notifications.enabled" ]] || exit 0
command -v osascript >/dev/null 2>&1 || exit 0

runtime="${TMPDIR:-/tmp}"
lock="$runtime/mins-terminal-notify-${UID}.lock"
stamp="$runtime/mins-terminal-notify-${UID}.stamp"
umask 077
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM

now="$(date +%s)"
last="$(cat "$stamp" 2>/dev/null || true)"
case "$last" in
  ''|*[!0-9]*) ;;
  *)
    if ((now >= last && now - last < 2)); then
      exit 0
    fi
    ;;
esac
printf '%s\n' "$now" >"$stamp"

osascript -e 'display notification "An agent needs attention" with title "Alacritty" sound name "Glass"' \
  >/dev/null 2>&1 || true
exit 0
