#!/usr/bin/env bash
# Serialize every manual, lifecycle, and Continuum tmux-resurrect save.
set -u

# Mirrors the resolution order in lib/paths.sh; nothing is inherited from tmux.
marker="${ENVY_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/envy}/tmux-persistence.enabled"
[[ -f "$marker" ]] || exit 0
command -v tmux >/dev/null 2>&1 || exit 0
umask 077

server_pid=$(tmux display-message -p '#{pid}' 2>/dev/null) || exit 0
runtime_dir=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}
lock_dir="$runtime_dir/nv-tmux-save-${UID:-$(id -u)}-$server_pid.lock"

if ! mkdir "$lock_dir" 2>/dev/null; then
  exit 0
fi
trap 'rmdir "$lock_dir" 2>/dev/null || true' EXIT INT HUP TERM

save_script=$(tmux show-option -gqv @nv_resurrect-save-script 2>/dev/null)
[[ -n "$save_script" && -x "$save_script" ]] || exit 0

# tmux-resurrect names snapshots only to the second and would overwrite an
# existing same-second checkpoint. Wait until the next name is free so rapid
# manual saves stay distinct.
resurrect_dir=$(tmux show-option -gqv @resurrect-dir 2>/dev/null)
if [[ -n "$resurrect_dir" ]]; then
  while [[ -e "$resurrect_dir/tmux_resurrect_$(date +%Y%m%dT%H%M%S).txt" ]]; do
    sleep 0.2
  done
fi

"$save_script" "${1:-}"
