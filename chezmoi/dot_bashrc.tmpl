# .bashrc — managed by envy/chezmoi

export PATH="$HOME/.local/bin:$PATH"
[ -f {{ (joinPath .xdgConfigHome "envy/init-sh.env") | quote }} ] && source {{ (joinPath .xdgConfigHome "envy/init-sh.env") | quote }}

_nv_shell_dir={{ (joinPath .xdgConfigHome "envy/shell.d") | quote }}
if [ -d "$_nv_shell_dir" ]; then
  for _nv_fragment in "$_nv_shell_dir"/*.pre.bash; do
    [ -f "$_nv_fragment" ] && source "$_nv_fragment"
  done
fi

case $- in
  *i*)
    if [ -z "${ZSH_VERSION:-}" ] && [ -z "${ENVY_NO_ZSH:-}" ] \
      && [ -z "${ENVY_BASH_EXECD:-}" ] && command -v zsh >/dev/null 2>&1; then
      export ENVY_BASH_EXECD=1
      exec zsh
    fi
    ;;
esac

command -v mise >/dev/null && eval "$(mise activate bash)"

if [ -d "$_nv_shell_dir" ]; then
  for _nv_fragment in "$_nv_shell_dir"/*.bash; do
    case "$_nv_fragment" in *.pre.bash) ;; *) [ -f "$_nv_fragment" ] && source "$_nv_fragment" ;; esac
  done
fi
unset _nv_fragment _nv_shell_dir

[ -n "${ENVY_SECRETS_FILE:-}" ] && [ -f "$ENVY_SECRETS_FILE" ] && source "$ENVY_SECRETS_FILE"
[ -f ~/.bashrc.local ] && source ~/.bashrc.local
command -v bat >/dev/null && alias cat='bat --paging=never --style=plain'
command -v glow >/dev/null && alias md='glow'
[ -f {{ (joinPath .xdgConfigHome "envy/tmux-autoattach.sh") | quote }} ] && source {{ (joinPath .xdgConfigHome "envy/tmux-autoattach.sh") | quote }}
